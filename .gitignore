# ==============================================================================
# TechSift AI - Git Ignore Configuration
# Comprehensive rules for privacy, secrets protection, and build cleanliness
# ==============================================================================

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/

# Database Files, WAL, SHM, and SQLite Artifacts
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
techsift.db*
demo_*.db*
verified_demo_*.db*
data/

# Storage Directories, Uploads, and Generated Media
storage/
demo_storage/
verified_demo_storage/
uploads/
temp/
tmp/
*.mp3
*.wav
*.ogg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
test-results/
playwright-report/

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor Artifacts
.DS_Store
**/.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
