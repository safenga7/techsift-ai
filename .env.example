# ==============================================================================
# TechSift AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file containing real API keys or credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Free Tier)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Free tier requires no credit card. Availability and limits are subject to Google.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RPM=10
GEMINI_MAX_RETRIES=1
GEMINI_INITIAL_BACKOFF_SECONDS=2.0
GEMINI_BACKOFF_FACTOR=2.0

# ------------------------------------------------------------------------------
# Server & Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database (Local SQLite)
# ------------------------------------------------------------------------------
# Asynchronous SQLite database path using aiosqlite driver
DATABASE_URL=sqlite+aiosqlite:///./techsift.db

# ------------------------------------------------------------------------------
# Storage & Document Limits
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
DOCUMENTS_DIR=./storage/documents
AUDIO_DIR=./storage/audio
MAX_UPLOAD_SIZE_BYTES=15728640
ALLOWED_EXTENSIONS=pdf,txt,md

# ------------------------------------------------------------------------------
# Audio & Speech Synthesis
# ------------------------------------------------------------------------------
# Options: "edge-tts" (Microsoft neural voices, default), "piper" (local ONNX), "local" (OS native)
AUDIO_PROVIDER=edge-tts
